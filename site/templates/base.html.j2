{#-
  base.html.j2: the shell every page extends. Block names and the template context are
  frozen in site/CONTRACT.md ("Templates"). No inline <script>, <style>, style="" or on*=""
  anywhere: the CSP blocks them. Rendered with autoescape and StrictUndefined.
-#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ page.title }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ page.description }}{% endblock %}">
{% if page.canonical %}
<link rel="canonical" href="{{ site.base_url }}{{ page.path }}">
{% endif %}
<meta name="color-scheme" content="light dark">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:url" content="{{ site.base_url }}{{ page.path }}">
<meta property="og:image" content="{{ site.base_url }}/share.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="{{ assets.css }}">
{% block scripts %}
<script type="module" src="{{ assets.js }}"></script>
{% endblock %}
{% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
{% block header %}
<a class="site-name" href="/">{{ site.name }}</a>
<nav class="site-nav" aria-label="Site">
<ul>
{% for href, label in [("/", "Fonts"), ("/methodology/", "How we rank"), ("/about/", "About"), ("/privacy/", "Privacy")] %}
<li><a href="{{ href }}"{% if page.path == href %} aria-current="page"{% endif %}>{{ label }}</a></li>
{% endfor %}
</ul>
</nav>
{% endblock %}
</header>
<main id="main" tabindex="-1">
{% block main %}{% endblock %}
</main>
<footer class="site-footer">
{% block footer %}
<div class="feedback" id="feedback">
{% block feedback %}
<p>Something wrong or missing? <a href="{{ site.feedback.issues_url }}">Report it on GitHub</a>, or email <a href="{{ site.feedback.mailto }}">{{ site.feedback.email }}</a>.</p>
{% endblock %}
</div>
{% block tip_link %}
{% if site.tip_url %}
<p class="tip" id="tip"><a href="{{ site.tip_url }}">Buy me a coffee ($5)</a>: a tip for keeping the list up to date, paid on Stripe's page.</p>
{% endif %}
{% endblock %}
<p class="footer-meta">Data from {{ build.run_date }}. <a href="{{ site.repo_url }}">Source code on GitHub</a>.</p>
{% endblock %}
</footer>
</body>
</html>
