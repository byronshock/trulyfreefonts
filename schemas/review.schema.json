{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trulyfreefonts.com/schemas/review/1",
  "title": "Owner rulings file",
  "description": "data/reviews/<gate dir>/<YYYY-MM-DD>.toml after TOML parsing (tff_catalog.reviews): one table per question id. ruling and reason are required; a lettered question adds choice and recommended; other keys hold the answer's values (site wording).",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "type": "string",
    "maxLength": 64,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/answer"
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000b-\\u001f\\u007f]"
      }
    },
    "answer": {
      "type": "object",
      "required": [
        "ruling",
        "reason"
      ],
      "properties": {
        "ruling": {
          "$ref": "#/$defs/text"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "choice": {
          "type": "string",
          "pattern": "^[a-z]$"
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "dependentRequired": {
        "choice": [
          "recommended"
        ],
        "recommended": [
          "choice"
        ]
      },
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        ]
      }
    }
  }
}
