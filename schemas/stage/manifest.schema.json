{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trulyfreefonts.com/schemas/stage/manifest/1",
  "title": "Snapshot manifest",
  "description": "$TFF_STORE/<source>/<date>/manifest.json (design-m1 §4; store.Manifest).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collector_version",
    "complete",
    "data_date",
    "date",
    "extracts",
    "fetched",
    "notes",
    "schema",
    "source",
    "stale_of",
    "window"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "date": {
      "$ref": "#/$defs/date"
    },
    "collector_version": {
      "type": "integer",
      "minimum": 1
    },
    "complete": {
      "type": "boolean"
    },
    "data_date": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/date"
        }
      ]
    },
    "window": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/date"
            },
            "end": {
              "$ref": "#/$defs/date"
            }
          }
        }
      ]
    },
    "fetched": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bytes",
          "etag",
          "fetched_at",
          "kept",
          "last_modified",
          "sha256",
          "status",
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://\\S+$"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "fetched_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^([0-9a-f]{64})?$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "etag": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_modified": {
            "type": [
              "string",
              "null"
            ]
          },
          "kept": {
            "type": "boolean"
          }
        }
      }
    },
    "extracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bytes",
          "path",
          "rows",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "stale_of": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/date"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
